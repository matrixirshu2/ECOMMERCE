# Supabase (Vercel production)
# Use the current Supabase API Keys page values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Backward-compatible aliases used by existing app code
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (India) - keep secret values server-side
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional email provider
RESEND_API_KEY=

# Store
NEXT_PUBLIC_STORE_NAME=ECOMMERCE
NEXT_PUBLIC_STORE_CURRENCY=INR
NEXT_PUBLIC_STORE_URL=http://localhost:3000
